# Copy to .env and change the two secrets. .env is git-ignored.
# Any random string; every Airflow component must share it.
AIRFLOW_JWT_SECRET=change-me
# Password of the `warehouse` role (set when the database volume is first created).
WAREHOUSE_PASSWORD=change-me

# Rows loaded per TLC file. 50000 = small sample (the default). 0 = whole files.
TLC_MAX_ROWS=50000
# Where tlc-ingest downloads from. The real TLC CDN by default.
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net
# Quality gate: minimum share of valid trips (mart_file_quality.valid_pct) per file.
QUALITY_MIN_VALID_PCT=90
# Optional: failure alerts are also posted here (Slack incoming-webhook format).
ALERT_WEBHOOK_URL=

# Host ports (bound to 127.0.0.1) and the PostgreSQL memory cap.
AIRFLOW_PORT=8080
WAREHOUSE_PORT=5433
PG_MEM_LIMIT=2g
# On Linux, set to the output of `id -u` so files in mounted folders are yours.
AIRFLOW_UID=50000
